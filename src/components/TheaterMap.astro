---
import { theaterDemo } from "../data/visuals/demo";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const viewBoxWidth = 1000;
const viewBoxHeight = 610;
const nodeById = new Map(theaterDemo.scene.nodes.map((node) => [node.id, node]));

function curvePath(linkId: string, fromId: string, toId: string): string | null {
  const from = nodeById.get(fromId);
  const to = nodeById.get(toId);
  if (!from || !to) return null;

  const startX = from.x * viewBoxWidth;
  const startY = from.y * viewBoxHeight;
  const endX = to.x * viewBoxWidth;
  const endY = to.y * viewBoxHeight;
  const deltaX = endX - startX;
  const deltaY = endY - startY;
  const length = Math.max(1, Math.hypot(deltaX, deltaY));
  const direction = Array.from(linkId).reduce((sum, character) => sum + character.charCodeAt(0), 0) % 2 === 0 ? 1 : -1;
  const bend = Math.min(72, length * 0.14) * direction;
  const controlX = (startX + endX) / 2 - (deltaY / length) * bend;
  const controlY = (startY + endY) / 2 + (deltaX / length) * bend;
  return `M ${startX} ${startY} Q ${controlX} ${controlY} ${endX} ${endY}`;
}

const fallbackLinks = theaterDemo.scene.links.flatMap((link) => {
  const path = curvePath(link.id, link.from, link.to);
  return path ? [{ ...link, path }] : [];
});
---

<figure class:list={["theater-map", className]} data-theater-map>
  <header class="theater-map__header">
    <div>
      <p class="theater-map__kicker">DAA theater / deterministic replay</p>
      <h3>Bounded authority, rendered in motion.</h3>
    </div>
    <div class="theater-map__badges" aria-label="Visualization provenance and safety status">
      <strong>{theaterDemo.provenance.visibleLabel}</strong>
      <span>Symbolic</span>
      <span>Not live</span>
    </div>
  </header>

  <div class="theater-map__viewport" data-theater-viewport>
    <svg
      class="theater-map__fallback"
      viewBox={`0 0 ${viewBoxWidth} ${viewBoxHeight}`}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Static topology of thirteen synthetic symbolic nodes and twelve bounded links."
    >
      <g class="theater-map__fallback-links" aria-hidden="true">
        {fallbackLinks.map((link) => (
          <path d={link.path} data-link-kind={link.kind} />
        ))}
      </g>
      <g class="theater-map__fallback-nodes">
        {theaterDemo.scene.nodes.map((node) => (
          <g transform={`translate(${node.x * viewBoxWidth} ${node.y * viewBoxHeight})`} data-node-role={node.role}>
            <circle r={node.role === "defender" ? 14 : node.role === "objective" ? 9 : 6} />
            {node.role === "defender" && <circle class="theater-map__fallback-node-ring" r="25" />}
            <text x="14" y="-13">{node.label}</text>
          </g>
        ))}
      </g>
      <path
        class="theater-map__fallback-signal"
        d="M 100 134 Q 294 28 480 140"
        aria-hidden="true"
      />
      <circle class="theater-map__fallback-pulse" cx="347" cy="77" r="5" aria-hidden="true" />
    </svg>

    <canvas class="theater-map__canvas" data-theater-canvas aria-hidden="true"></canvas>

    <div class="theater-map__viewport-labels" aria-hidden="true">
      <span>Normalized abstract coordinates</span>
      <span>Zero runtime data connections</span>
    </div>
  </div>

  <div class="theater-map__console">
    <div class="theater-map__controls" aria-label="Symbolic theater replay controls">
      <button type="button" data-theater-toggle aria-pressed="false" disabled>Play</button>
      <button type="button" data-theater-restart disabled>Restart</button>
      <button type="button" data-theater-step disabled>Step</button>
      <p class="theater-map__step-count">
        Step <output data-theater-current>1</output> / {theaterDemo.scene.steps}
      </p>
    </div>

    <p class="theater-map__status" data-theater-status>
      Ready. Step 1 of {theaterDemo.scene.steps}. Synthetic symbolic replay.
    </p>

    <ul class="theater-map__legend" aria-label="Theater legend">
      <li><span data-legend="decision"></span><strong>Decision</strong> bounded symbolic selection</li>
      <li><span data-legend="attempt"></span><strong>Attempt</strong> accepted route event</li>
      <li><span data-legend="intervention"></span><strong>Intervention</strong> defender response</li>
      <li><span data-legend="node"></span><strong>Node</strong> fictional principal or objective</li>
    </ul>
  </div>

  <figcaption>
    A deterministic presentation mockup using invented aliases and normalized
    coordinates. It is not an attack map, live feed, or scientific result.
  </figcaption>
</figure>

<script>
  import "../scripts/theater-map.ts";
</script>

<style>
  .theater-map {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid #2e3334;
    background: #080909;
    color: #f4f2ee;
  }

  .theater-map__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: end;
    padding: clamp(24px, 4vw, 52px);
    border-bottom: 1px solid #2e3334;
  }

  .theater-map__kicker {
    margin: 0 0 14px;
    color: #ff5b45;
    font: 700 0.62rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .theater-map h3 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 5.2rem);
    font-weight: 680;
    line-height: 0.95;
    letter-spacing: -0.052em;
  }

  .theater-map__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    justify-content: flex-end;
    max-width: 390px;
  }

  .theater-map__badges strong,
  .theater-map__badges span {
    padding: 8px 10px;
    border: 1px solid rgba(146, 153, 154, 0.32);
    color: #d8d8d2;
    font: 700 0.54rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .theater-map__badges strong {
    border-color: rgba(255, 91, 69, 0.7);
    color: #ff5b45;
  }

  .theater-map__viewport {
    position: relative;
    aspect-ratio: 1.72 / 1;
    min-height: 360px;
    overflow: hidden;
    border-bottom: 1px solid #2e3334;
    background:
      radial-gradient(circle at 50% 48%, rgba(255, 91, 69, 0.065), transparent 22%),
      linear-gradient(rgba(146, 153, 154, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(146, 153, 154, 0.055) 1px, transparent 1px),
      #070808;
    background-size: auto, 42px 42px, 42px 42px, auto;
  }

  .theater-map__viewport::before,
  .theater-map__viewport::after {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    content: "";
  }

  .theater-map__viewport::before {
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 52%, rgba(5, 5, 5, 0.76) 100%);
  }

  .theater-map__viewport::after {
    inset: 0 0 auto;
    height: 1px;
    background: rgba(255, 91, 69, 0.55);
    box-shadow: 0 0 22px rgba(255, 91, 69, 0.35);
  }

  .theater-map__fallback,
  .theater-map__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .theater-map__fallback {
    z-index: 1;
    display: block;
    opacity: 0.92;
    transition: opacity 280ms ease;
  }

  .theater-map__canvas {
    z-index: 2;
    display: block;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .theater-map.is-enhanced .theater-map__fallback {
    opacity: 0;
  }

  .theater-map.is-enhanced .theater-map__canvas {
    opacity: 1;
  }

  .theater-map__fallback-links path {
    fill: none;
    stroke: rgba(146, 153, 154, 0.3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .theater-map__fallback-links [data-link-kind="attempt"] {
    stroke: rgba(255, 91, 69, 0.25);
  }

  .theater-map__fallback-nodes circle {
    fill: #080909;
    stroke: #d8d8d2;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .theater-map__fallback-nodes [data-node-role="principal"] circle {
    fill: #ff5b45;
    stroke: #ff5b45;
  }

  .theater-map__fallback-nodes [data-node-role="defender"] circle {
    fill: #f4f2ee;
    stroke: #f4f2ee;
  }

  .theater-map__fallback-nodes .theater-map__fallback-node-ring {
    fill: none;
    stroke: rgba(255, 91, 69, 0.8);
  }

  .theater-map__fallback-nodes text {
    fill: rgba(216, 216, 210, 0.72);
    font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 1px;
  }

  .theater-map__fallback-signal {
    fill: none;
    stroke: #ff5b45;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .theater-map__fallback-pulse {
    fill: #ff5b45;
  }

  .theater-map__viewport-labels {
    position: absolute;
    z-index: 4;
    inset: auto 18px 16px;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: rgba(216, 216, 210, 0.42);
    font: 650 0.52rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .theater-map__console {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
    gap: 0;
  }

  .theater-map__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 22px clamp(20px, 3vw, 38px);
    border-right: 1px solid #2e3334;
  }

  .theater-map__controls button {
    min-width: 88px;
    min-height: 42px;
    padding: 10px 14px;
    border: 1px solid rgba(146, 153, 154, 0.4);
    border-radius: 0;
    background: transparent;
    color: #f4f2ee;
    font: 700 0.59rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .theater-map__controls button:first-child {
    border-color: #ff5b45;
    color: #ff5b45;
  }

  .theater-map__controls button:hover:not(:disabled) {
    border-color: #f4f2ee;
    background: #f4f2ee;
    color: #050505;
  }

  .theater-map__controls button:disabled {
    cursor: not-allowed;
    opacity: 0.44;
  }

  .theater-map__step-count {
    margin: 0 0 0 auto;
    color: #92999a;
    font: 700 0.59rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .theater-map__status {
    align-self: center;
    margin: 0;
    padding: 22px clamp(20px, 3vw, 38px);
    color: #d8d8d2;
    font: 620 0.66rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
  }

  .theater-map__legend {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid #2e3334;
    list-style: none;
  }

  .theater-map__legend li {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: 2px 10px;
    align-items: center;
    min-height: 82px;
    padding: 16px 20px;
    color: #92999a;
    font: 560 0.59rem/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .theater-map__legend li + li {
    border-left: 1px solid #2e3334;
  }

  .theater-map__legend strong {
    color: #f4f2ee;
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .theater-map__legend span {
    grid-row: 1 / span 2;
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .theater-map__legend [data-legend="decision"] {
    background: #d8d8d2;
    color: #d8d8d2;
  }

  .theater-map__legend [data-legend="attempt"] {
    background: #ff5b45;
    color: #ff5b45;
  }

  .theater-map__legend [data-legend="intervention"] {
    box-shadow: 0 0 0 3px rgba(244, 242, 238, 0.13);
    color: #f4f2ee;
  }

  .theater-map__legend [data-legend="node"] {
    border-radius: 0;
    transform: rotate(45deg);
    color: #92999a;
  }

  .theater-map figcaption {
    padding: 18px clamp(20px, 3vw, 38px);
    border-top: 1px solid #2e3334;
    color: #92999a;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .theater-map__header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .theater-map__badges {
      justify-content: flex-start;
    }

    .theater-map__console {
      grid-template-columns: 1fr;
    }

    .theater-map__controls {
      border-right: 0;
      border-bottom: 1px solid #2e3334;
    }

    .theater-map__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .theater-map__legend li:nth-child(3) {
      border-top: 1px solid #2e3334;
      border-left: 0;
    }

    .theater-map__legend li:nth-child(4) {
      border-top: 1px solid #2e3334;
    }
  }

  @media (max-width: 580px) {
    .theater-map__viewport {
      min-height: 390px;
      aspect-ratio: 0.95 / 1;
    }

    .theater-map__viewport-labels span:last-child {
      display: none;
    }

    .theater-map__controls button {
      flex: 1 1 30%;
      min-width: 0;
    }

    .theater-map__step-count {
      flex-basis: 100%;
      margin: 9px 0 0;
    }

    .theater-map__legend {
      grid-template-columns: 1fr;
    }

    .theater-map__legend li + li,
    .theater-map__legend li:nth-child(3) {
      border-top: 1px solid #2e3334;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theater-map__fallback,
    .theater-map__canvas {
      transition: none;
    }
  }
</style>
