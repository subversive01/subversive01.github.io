---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  articleSection?: string;
  tags?: string[];
  scholarly?: {
    title: string;
    doi: string;
    publicationDate: Date;
    institution: string;
    reportNumber: string;
  };
}

const {
  title,
  description,
  image = "/assets/blog/research-log-og.png",
  imageAlt = "SBHC Security — independent cybersecurity research",
  type = "website",
  publishedAt,
  updatedAt,
  author = "Mario Oliva",
  articleSection,
  tags = [],
  scholarly
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const productionCsp = "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={productionCsp} />}
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="SBHC Security" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1728" />
    <meta property="og:image:height" content="910" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {type === "article" && <meta property="article:author" content={author} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {scholarly && (
      <>
        <meta name="citation_title" content={scholarly.title} />
        <meta name="citation_author" content={author} />
        <meta name="citation_publication_date" content={scholarly.publicationDate.toISOString().slice(0, 10).replaceAll("-", "/")} />
        <meta name="citation_doi" content={scholarly.doi} />
        <meta name="citation_language" content="en" />
        <meta name="citation_technical_report_institution" content={scholarly.institution} />
        <meta name="citation_technical_report_number" content={scholarly.reportNumber} />
        <meta name="citation_abstract_html_url" content={canonical} />
      </>
    )}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
