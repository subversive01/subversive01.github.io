---
import { getCollection } from "astro:content";
import SignalLattice from "../../components/SignalLattice.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const daaRoute = "/research/daa/";
const entries = (await getCollection("research")).sort((a, b) => {
  if (a.data.route === daaRoute) return -1;
  if (b.data.route === daaRoute) return 1;
  return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
---

<BaseLayout
  title="Research — SBHC Security"
  description="Formal cybersecurity research, bounded experiments, methods, and evidence notes from SBHC Security."
>
  <div class="research-shell research-index-shell">
    <SiteHeader active="research" />
    <main class="research-index-page">
      <header class="research-index-hero">
        <SignalLattice
          seed={1842}
          primaryLabel="Cybersecurity / formal research"
          secondaryLabel="Methods / evidence / limitations"
        />
        <div class="research-index-copy">
          <p class="eyebrow">Investigations / Experiments / Evidence</p>
          <h1>RESEARCH</h1>
          <p>
            My formal investigations into cybersecurity, distributed systems,
            incident response, security operations, and emerging technical risk.
          </p>
        </div>
        <dl class="research-index-meta" aria-label="Research index status">
          <div><dt>Entries</dt><dd>{String(entries.length).padStart(2, "0")}</dd></div>
          <div><dt>Format</dt><dd>Research journal</dd></div>
        </dl>
      </header>

      <section class="research-entry-index" aria-label="Research entries">
        <div class="research-entries">
          {entries.map((entry, index) => {
            const date = entry.data.publishedAt.toLocaleDateString("en-US", {
              month: "short",
              day: "2-digit",
              year: "numeric",
              timeZone: "UTC"
            });
            return (
              <article class="research-entry">
                <a href={entry.data.route ?? `/research/${entry.id}/`} aria-label={`Open ${entry.data.title}`}>
                  <span class="research-number">{String(index + 1).padStart(2, "0")}</span>
                  <div class="research-title">
                    <p>{entry.data.study} / {entry.data.version}</p>
                    <h3>{entry.data.title}</h3>
                  </div>
                  <p class="research-description">{entry.data.description}</p>
                  <div class="research-entry-meta">
                    <span>{entry.data.status.replaceAll("-", " ")}</span>
                    <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
                  </div>
                  <strong aria-hidden="true">↗</strong>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .research-index-shell { min-height: 100svh; }
  .research-index-page { border-bottom: 1px solid var(--line); background: var(--ink); }
  .research-index-hero {
    position: relative;
    display: grid;
    min-height: min(690px, calc(100svh - 76px));
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(rgba(167, 173, 174, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(167, 173, 174, .045) 1px, transparent 1px),
      var(--ink);
    background-size: 42px 42px;
  }

  .research-index-copy {
    position: relative;
    z-index: 2;
    align-self: center;
    width: min(100%, 980px);
    padding: 74px var(--page-pad);
    pointer-events: none;
  }

  .research-index-hero h1 {
    margin: 0;
    font-size: clamp(4.8rem, min(12vw, 16vh), 12rem);
    line-height: .78;
    letter-spacing: -.085em;
  }

  .research-index-copy > p:last-child {
    max-width: 680px;
    margin: clamp(30px, 4vh, 44px) 0 0;
    color: var(--paper);
    font-size: clamp(1rem, 1.45vw, 1.28rem);
    line-height: 1.65;
  }

  .research-index-meta {
    position: absolute;
    right: clamp(32px, 5vw, 80px);
    bottom: 32px;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 34px;
    margin: 0;
  }

  .research-index-meta div { display: grid; gap: 5px; }
  .research-index-meta dt,
  .research-index-meta dd { margin: 0; font: 650 .56rem/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .research-index-meta dt { color: var(--muted); }

  .research-entry-index { border-bottom: 1px solid var(--line); }
  .research-entry + .research-entry { border-top: 1px solid var(--line); }
  .research-entry > a {
    position: relative;
    display: grid;
    min-height: 220px;
    grid-template-columns: 64px minmax(250px, .72fr) minmax(300px, 1fr) 160px 28px;
    gap: clamp(22px, 3vw, 52px);
    align-items: center;
    padding: 34px var(--page-pad);
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .research-entry > a::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--signal);
    content: "";
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .research-entry > a:hover { background: var(--ink-raised); }
  .research-entry > a:hover::before,
  .research-entry > a:focus-visible::before { opacity: 1; }
  .research-number { align-self: start; color: var(--signal); font: 700 .6rem/1 var(--mono); }
  .research-title p { margin: 0 0 18px; color: var(--signal); font: 700 .57rem/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .research-title h3 { margin: 0; font-size: clamp(2.1rem, 3.8vw, 4.6rem); line-height: .9; letter-spacing: -.055em; }
  .research-description { max-width: 650px; margin: 0; color: var(--muted); line-height: 1.7; }
  .research-entry-meta { display: grid; gap: 12px; color: var(--muted); font: 650 .56rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .research-entry-meta span { color: var(--white); }
  .research-entry > a > strong { color: var(--signal); font: 700 1rem/1 var(--mono); }

  @media (max-width: 980px) {
    .research-entry > a { grid-template-columns: 48px minmax(0, 1fr) 130px 24px; }
    .research-description { grid-column: 2; }
    .research-entry-meta { grid-column: 3; grid-row: 1 / span 2; }
    .research-entry > a > strong { grid-column: 4; grid-row: 1 / span 2; }
  }

  @media (max-width: 760px) {
    .research-index-hero { min-height: min(650px, calc(100svh - 68px)); }
    .research-index-copy { padding: 92px 24px 70px; }
    .research-index-hero h1 { font-size: clamp(3.8rem, 21vw, 6.5rem); }
    .research-index-copy > p:last-child { max-width: 88%; font-size: .95rem; }
    .research-index-meta { right: 20px; bottom: 18px; gap: 24px; }
    .research-index-meta div:last-child { display: none; }
    .research-entry > a {
      min-height: 380px;
      grid-template-columns: 34px minmax(0, 1fr) 22px;
      grid-template-rows: auto auto auto;
      gap: 20px 14px;
      align-items: start;
      padding: 38px 24px;
    }
    .research-number { grid-column: 1; grid-row: 1 / -1; }
    .research-title { grid-column: 2; }
    .research-title h3 { font-size: clamp(2.45rem, 11.5vw, 4rem); }
    .research-description { grid-column: 2 / -1; grid-row: 2; }
    .research-entry-meta { grid-column: 2; grid-row: 3; grid-template-columns: repeat(2, auto); justify-content: start; gap: 22px; }
    .research-entry > a > strong { grid-column: 3; grid-row: 1; }
  }
</style>
