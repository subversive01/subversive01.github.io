---
import { getEntry, render } from "astro:content";
import SignalLattice from "../../../components/SignalLattice.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const article = await getEntry("daa", "article");
const references = await getEntry("daa", "references");
if (!article || !references) throw new Error("DAA publication content is missing");

const { Content, headings } = await render(article);
const { Content: References } = await render(references);
const sections = headings.filter((heading) => heading.depth === 2);
const publishedAt = new Date("2026-08-28T00:00:00.000Z");
---

<BaseLayout
  title="Distributed Agentic Attacks — SBHC Security Research"
  description="A proposed threat model for large-scale distributed offensive agency, with field evidence, controlled experiments, limitations, and reproducibility record."
  type="article"
  publishedAt={publishedAt}
>
  <div class="research-shell daa-shell">
    <SiteHeader active="research" />
    <main>
      <header class="daa-hero" aria-labelledby="daa-title">
        <SignalLattice
          seed={4764}
          primaryLabel="Decision authority / distributed loci"
          secondaryLabel="Field evidence / bounded studies"
        />
        <div class="daa-hero-copy">
          <p class="eyebrow">Publication page / August 2026</p>
          <h1 id="daa-title">
            <span class="daa-title-word">Distributed</span>
            <span class="daa-title-row"><span class="daa-title-outline">Agentic</span><span class="daa-title-word">Attacks</span></span>
          </h1>
          <p class="daa-paper-title">A Proposed Threat Model for Large-Scale Distributed Offensive Agency</p>
          <p class="daa-hook">What changes for defenders when <strong>consequential tactical decision authority is materially dispersed across distinguishable artificial decision loci?</strong></p>
          <a class="button button-primary" href="#abstract">Read the research <span aria-hidden="true">↓</span></a>
        </div>
        <dl class="daa-hero-meta" aria-label="Publication details">
          <div><dt>Author</dt><dd>Mario Oliva</dd></div>
          <div><dt>Version</dt><dd>Publication Paper v6.4.3</dd></div>
          <div><dt>Status</dt><dd>Preprint / not peer reviewed</dd></div>
          <div><dt>Reading time</dt><dd>48 minutes</dd></div>
        </dl>
      </header>

      <div class="daa-signal-strip" aria-label="Research boundaries">
        <span>Authority ≠ activity</span><i></i><span>Scale ≠ advantage</span><i></i>
        <span>Terminal-symbolic studies</span><i></i><span>No live-system effects</span>
      </div>

      <section class="daa-results" aria-labelledby="results-title">
        <header>
          <p class="section-label">Page overview / Three separate propositions</p>
          <h2 id="results-title">What the evidence supports</h2>
        </header>
        <ol>
          <li><span>01</span><strong>Authority exercised</strong><p>Supported within two bounded symbolic apparatuses.</p></li>
          <li><span>02</span><strong>Scaled load observed</strong><p>Demonstrated as architecture-neutral queue mechanics.</p></li>
          <li><span>03</span><strong>Distributed burden premium</strong><p>Not supported under the registered analyses.</p></li>
        </ol>
      </section>

      <article class="daa-paper" id="paper" aria-label="Canonical publication text, version 6.4.3">
        <div class="daa-paper-layout">
          <nav class="daa-index" aria-labelledby="daa-index-title">
            <p id="daa-index-title">In this paper</p>
            <span>{sections.length} sections / 48 min</span>
            <ol>
              {sections.map((heading, index) => (
                <li><a href={`#${heading.slug}`}><b>{String(index + 1).padStart(2, "0")}</b>{heading.text}</a></li>
              ))}
              <li><a href="#sources-heading"><b>REF</b>Sources &amp; references</a></li>
            </ol>
          </nav>

          <details class="daa-mobile-index">
            <summary><span>In this paper</span><b>{sections.length} sections</b></summary>
            <nav aria-label="Publication sections">
              <ol>
                {sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
                <li><a href="#sources-heading">Sources &amp; references</a></li>
              </ol>
            </nav>
          </details>

          <div class="daa-prose">
            <Content />
          </div>
        </div>
      </article>

      <section class="daa-references" aria-labelledby="sources-heading">
        <details>
          <summary>
            <span><small>Research record / Complete bibliography</small><strong id="sources-heading">Sources &amp; references</strong></span>
            <b>56 sources <i aria-hidden="true">＋</i></b>
          </summary>
          <div class="daa-reference-list"><References /></div>
        </details>
      </section>

      <section class="daa-artifacts" aria-labelledby="artifacts-title">
        <header>
          <p class="section-label">Publication files / Zenodo</p>
          <h2 id="artifacts-title">Research artifacts</h2>
          <p>Citable publication files and supporting records are preserved on Zenodo.</p>
        </header>
        <ol>
          <li>
            <a href="https://zenodo.org/records/22150935">
              <span>01</span>
              <span>
                <small>Publication paper / v6.4.3</small>
                <strong>Distributed Agentic Attacks: A Proposed Threat Model for Large-Scale Distributed Offensive Agency</strong>
                <code>DOI 10.5281/zenodo.22150935</code>
              </span>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
          <li>
            <a href="https://zenodo.org/records/22150937">
              <span>02</span>
              <span>
                <small>Research dossier / v4.4.3</small>
                <strong>Distributed Agentic Attacks: Research Dossier and Source-Provenance Record</strong>
                <code>DOI 10.5281/zenodo.22150937</code>
              </span>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
          <li>
            <a href="https://zenodo.org/records/22150939">
              <span>03</span>
              <span>
                <small>Evidence &amp; reproducibility / v1.4.2</small>
                <strong>Distributed Agentic Attacks: Experimental Evidence and Reproducibility Record</strong>
                <code>DOI 10.5281/zenodo.22150939</code>
              </span>
              <i aria-hidden="true">↗</i>
            </a>
          </li>
        </ol>
      </section>

      <footer class="daa-end">
        <p>Distributed Agentic Attacks / Publication Paper v6.4.3</p>
        <a href="/research/">Return to Research <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .daa-shell { background: var(--ink); }
  .daa-hero {
    position: relative;
    display: grid;
    min-height: min(880px, calc(100svh - 76px));
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(rgba(167, 173, 174, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(167, 173, 174, .045) 1px, transparent 1px),
      var(--ink);
    background-size: 42px 42px;
  }

  :global(.daa-hero .signal-lattice__fallback),
  :global(.daa-hero .signal-lattice__canvas) {
    -webkit-mask-image: linear-gradient(90deg, transparent 0 52%, #000 72%);
    mask-image: linear-gradient(90deg, transparent 0 52%, #000 72%);
  }

  .daa-hero-copy {
    position: relative;
    z-index: 2;
    align-self: center;
    width: min(100%, 1240px);
    padding: clamp(84px, 10vh, 120px) var(--page-pad) clamp(148px, 17vh, 190px);
    pointer-events: none;
  }

  .daa-hero-copy h1 {
    display: grid;
    max-width: 1100px;
    margin: 0;
    font-size: clamp(4.4rem, min(10vw, 13vh), 10.8rem);
    font-weight: 760;
    line-height: .8;
    letter-spacing: -.075em;
  }

  .daa-title-word,
  .daa-title-row { display: block; }
  .daa-title-row { display: flex; align-items: baseline; gap: .12em; white-space: nowrap; }
  .daa-hero-copy h1 .daa-title-outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 242, 238, .86);
  }

  .daa-paper-title {
    max-width: 820px;
    margin: 30px 0 0;
    color: var(--muted);
    font: 680 clamp(.72rem, 1vw, .9rem)/1.55 var(--mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .daa-hook {
    max-width: 880px;
    margin: 24px 0 0;
    color: var(--paper);
    font-size: clamp(1.25rem, 2.15vw, 2rem);
    line-height: 1.42;
  }

  .daa-hook strong { color: var(--white); font-weight: 720; }
  .daa-hero-copy .button { margin-top: 30px; pointer-events: auto; }

  .daa-hero-meta {
    position: absolute;
    right: var(--page-pad);
    bottom: 38px;
    left: var(--page-pad);
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .daa-hero-meta div { min-width: 0; padding: 18px 22px 0 0; }
  .daa-hero-meta div + div { padding-left: 22px; border-left: 1px solid var(--line); }
  .daa-hero-meta dt,
  .daa-hero-meta dd { margin: 0; font: 650 .58rem/1.5 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .daa-hero-meta dt { margin-bottom: 6px; color: var(--muted); }
  .daa-hero-meta dd { overflow-wrap: anywhere; }

  .daa-signal-strip {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-around;
    gap: 24px;
    padding: 12px var(--page-pad);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font: 700 .57rem/1.3 var(--mono);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .daa-signal-strip i { width: 4px; height: 4px; flex: 0 0 auto; border-radius: 50%; background: var(--signal); box-shadow: 0 0 12px var(--signal); }

  .daa-results { border-bottom: 1px solid var(--line); }
  .daa-results > header { padding: clamp(46px, 5vw, 72px) var(--page-pad) clamp(32px, 4vw, 50px); }
  .daa-results h2 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 3.8vw, 4.4rem); line-height: .92; letter-spacing: -.045em; }
  .daa-results ol { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .daa-results li { min-height: 210px; padding: clamp(30px, 3vw, 46px); }
  .daa-results li + li { border-left: 1px solid var(--line); }
  .daa-results li > span { display: block; margin-bottom: clamp(28px, 3vw, 42px); color: var(--signal); font: 700 .6rem/1 var(--mono); }
  .daa-results strong { display: block; font-size: clamp(1.55rem, 2.2vw, 2.55rem); line-height: .98; letter-spacing: -.035em; }
  .daa-results li:last-child strong { color: var(--signal); }
  .daa-results li p { max-width: 380px; margin: 17px 0 0; color: var(--muted); line-height: 1.55; }

  .daa-artifacts {
    display: grid;
    grid-template-columns: minmax(260px, .34fr) minmax(0, .66fr);
    border-bottom: 1px solid var(--line);
    background: var(--ink-raised);
  }

  .daa-artifacts > header { padding: clamp(48px, 6vw, 88px) var(--page-pad); }
  .daa-artifacts h2 { max-width: 560px; margin: 0; font-size: clamp(2.5rem, 4.2vw, 5rem); line-height: .9; letter-spacing: -.055em; }
  .daa-artifacts > header > p:last-child { max-width: 440px; margin: 28px 0 0; color: var(--muted); line-height: 1.6; }
  .daa-artifacts ol { margin: 0; padding: 0; border-left: 1px solid var(--line); list-style: none; }
  .daa-artifacts li + li { border-top: 1px solid var(--line); }
  .daa-artifacts a {
    display: grid;
    min-height: 176px;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(18px, 2.5vw, 38px);
    padding: clamp(30px, 4vw, 54px);
    text-decoration: none;
  }

  .daa-artifacts a > span:first-child { color: var(--signal); font: 700 .6rem/1.4 var(--mono); }
  .daa-artifacts a > span:nth-child(2) { display: grid; gap: 11px; }
  .daa-artifacts small,
  .daa-artifacts code { color: var(--muted); font: 700 .58rem/1.45 var(--mono); letter-spacing: .09em; text-transform: uppercase; }
  .daa-artifacts strong { max-width: 820px; color: var(--paper); font-size: clamp(1.15rem, 1.8vw, 1.7rem); line-height: 1.15; letter-spacing: -.025em; }
  .daa-artifacts i { color: var(--signal); font: 400 1.15rem/1 var(--sans); }
  .daa-artifacts a:hover strong,
  .daa-artifacts a:focus-visible strong { color: var(--white); }

  .daa-paper { border-bottom: 1px solid var(--line); }
  .daa-paper-layout { display: grid; grid-template-columns: minmax(250px, .27fr) minmax(0, .73fr); }
  .daa-index { position: sticky; top: 24px; align-self: start; max-height: calc(100svh - 48px); padding: 58px clamp(28px, 4vw, 62px); overflow-y: auto; }
  .daa-index > p { margin: 0 0 7px; color: var(--signal); font: 700 .6rem/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
  .daa-index > span { color: var(--muted); font: 650 .54rem/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .daa-index ol { margin: 30px 0 0; padding: 0; list-style: none; }
  .daa-index li { border-top: 1px solid var(--line); }
  .daa-index a { display: grid; grid-template-columns: 30px 1fr; gap: 12px; padding: 12px 0; color: var(--muted); font: 650 .57rem/1.35 var(--mono); text-decoration: none; text-transform: uppercase; }
  .daa-index a:hover,
  .daa-index a:focus-visible { color: var(--white); }
  .daa-index a b { color: var(--signal); font: inherit; }
  .daa-mobile-index { display: none; }

  .daa-prose {
    min-width: 0;
    padding: 32px clamp(48px, 9vw, 154px) clamp(72px, 8vw, 132px);
    border-left: 1px solid var(--line);
  }

  :global(.daa-prose > *) { max-width: 760px; }
  :global(.daa-prose .publication-context) { max-width: 900px; margin: 0 0 36px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  :global(.daa-prose .publication-context > summary) { display: flex; min-height: 56px; align-items: center; gap: 14px; color: var(--paper); cursor: pointer; list-style: none; }
  :global(.daa-prose .publication-context > summary::-webkit-details-marker) { display: none; }
  :global(.daa-prose .publication-context > summary span),
  :global(.daa-prose .publication-context > summary small) { font: 700 .6rem/1.4 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  :global(.daa-prose .publication-context > summary span) { color: var(--signal); }
  :global(.daa-prose .publication-context > summary small) { color: var(--muted); }
  :global(.daa-prose .publication-context > summary::after) { margin-left: auto; color: var(--signal); font: 400 1.15rem/1 var(--sans); content: "＋"; }
  :global(.daa-prose .publication-context[open] > summary::after) { content: "−"; }
  :global(.daa-prose .publication-context-body) { padding: 26px 0 10px; border-top: 1px solid var(--line); }
  :global(.daa-prose .publication-context-body p) { max-width: 820px; color: var(--muted); font: 400 clamp(.98rem, 1.1vw, 1.08rem)/1.72 Georgia, "Times New Roman", serif; }
  :global(.daa-prose h2) { max-width: 980px; margin: 2.2em 0 .72em; padding-top: .32em; scroll-margin-top: 28px; font-size: clamp(3.2rem, 5.8vw, 6.8rem); line-height: .88; letter-spacing: -.062em; overflow-wrap: anywhere; hyphens: auto; }
  :global(.daa-prose h2::before) { display: block; width: 42px; height: 2px; margin-bottom: 22px; background: var(--signal); content: ""; }
  :global(.daa-prose h2:first-of-type) { margin-top: 0; padding-top: 0; }
  :global(.daa-prose h3) { margin: 2.4em 0 .72em; padding-top: .65em; border-top: 1px solid var(--line); scroll-margin-top: 28px; font-size: clamp(2.15rem, 3.5vw, 4rem); line-height: .96; letter-spacing: -.045em; overflow-wrap: anywhere; hyphens: auto; }
  :global(.daa-prose h4) { margin: 2.25em 0 .8em; scroll-margin-top: 28px; font-size: clamp(1.4rem, 2.2vw, 2.25rem); line-height: 1.08; letter-spacing: -.03em; overflow-wrap: anywhere; hyphens: auto; }
  :global(.daa-prose h5) { margin: 2.2em 0 .72em; scroll-margin-top: 28px; color: var(--white); font-size: clamp(1.28rem, 1.85vw, 1.75rem); line-height: 1.16; letter-spacing: -.02em; }
  :global(.daa-prose h6) { margin: 2em 0 .7em; scroll-margin-top: 28px; color: var(--signal); font: 700 .72rem/1.5 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  :global(.daa-prose p) { margin: 0 0 1.48em; color: var(--paper); font: 400 clamp(1.08rem, 1.3vw, 1.22rem)/1.82 Georgia, "Times New Roman", serif; overflow-wrap: anywhere; }
  :global(.daa-prose strong) { color: var(--white); }
  :global(.daa-prose a) {
    color: var(--paper);
    text-decoration-color: rgba(255, 91, 69, .62);
    text-decoration-thickness: 1px;
    overflow-wrap: anywhere;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }
  :global(.daa-prose a:hover),
  :global(.daa-prose a:focus-visible) { color: var(--signal); text-decoration-color: currentColor; }
  :global(.daa-prose a.citation-link) {
    color: var(--muted);
    font: 700 .72em/1 var(--mono);
    text-decoration-color: rgba(255, 91, 69, .42);
    white-space: nowrap;
  }
  :global(.daa-prose a.citation-link:hover),
  :global(.daa-prose a.citation-link:focus-visible) { color: var(--signal); }
  :global(.daa-prose code) { color: var(--white); font: .82em/1.5 var(--mono); overflow-wrap: anywhere; }
  :global(.daa-prose hr) { max-width: none; margin: clamp(72px, 9vw, 140px) 0; border: 0; border-top: 1px solid var(--line); }
  :global(.daa-prose table) {
    width: 100%;
    max-width: 980px;
    margin: 2.8rem 0 4.4rem;
    border: 1px solid var(--line);
    border-collapse: collapse;
    color: var(--paper);
    table-layout: fixed;
  }
  :global(.daa-prose table:nth-of-type(1) th:nth-child(1)) { width: 34%; }
  :global(.daa-prose table:nth-of-type(1) th:nth-child(2)) { width: 20%; }
  :global(.daa-prose table:nth-of-type(1) th:nth-child(3)) { width: 46%; }
  :global(.daa-prose table:nth-of-type(2) th:nth-child(1)) { width: 22%; }
  :global(.daa-prose table:nth-of-type(2) th:nth-child(2)) { width: 35%; }
  :global(.daa-prose table:nth-of-type(2) th:nth-child(3)) { width: 43%; }
  :global(.daa-prose table:nth-of-type(3)) {
    width: calc(100% + min(10vw, 144px));
    max-width: none;
    margin-left: max(-72px, -5vw);
  }
  :global(.daa-prose table:nth-of-type(3) th:nth-child(1)) { width: 18%; }
  :global(.daa-prose table:nth-of-type(3) th:nth-child(2)) { width: 22%; }
  :global(.daa-prose table:nth-of-type(3) th:nth-child(3)) { width: 11%; }
  :global(.daa-prose table:nth-of-type(3) th:nth-child(4)) { width: 25%; }
  :global(.daa-prose table:nth-of-type(3) th:nth-child(5)) { width: 24%; }
  :global(.daa-prose table:nth-of-type(4) th:nth-child(1)) { width: 18%; }
  :global(.daa-prose table:nth-of-type(4) th:nth-child(2)) { width: 32%; }
  :global(.daa-prose table:nth-of-type(4) th:nth-child(3)) { width: 50%; }
  :global(.daa-prose table:nth-of-type(5) th:first-child),
  :global(.daa-prose table:nth-of-type(6) th:first-child) { width: 34%; }
  :global(.daa-prose table:nth-of-type(1) td:nth-child(1)) { --cell-label: "Example"; }
  :global(.daa-prose table:nth-of-type(1) td:nth-child(2)) { --cell-label: "DAA?"; }
  :global(.daa-prose table:nth-of-type(1) td:nth-child(3)) { --cell-label: "Why"; }
  :global(.daa-prose table:nth-of-type(2) td:nth-child(1)) { --cell-label: "Concept"; }
  :global(.daa-prose table:nth-of-type(2) td:nth-child(2)) { --cell-label: "Defining property"; }
  :global(.daa-prose table:nth-of-type(2) td:nth-child(3)) { --cell-label: "Relationship to proposed DAA"; }
  :global(.daa-prose table:nth-of-type(3) td:nth-child(1)) { --cell-label: "Study / status"; }
  :global(.daa-prose table:nth-of-type(3) td:nth-child(2)) { --cell-label: "Architecture focus"; }
  :global(.daa-prose table:nth-of-type(3) td:nth-child(3)) { --cell-label: "Design"; }
  :global(.daa-prose table:nth-of-type(3) td:nth-child(4)) { --cell-label: "Registered role"; }
  :global(.daa-prose table:nth-of-type(3) td:nth-child(5)) { --cell-label: "Reader definition"; }
  :global(.daa-prose table:nth-of-type(4) td:nth-child(1)) { --cell-label: "Study"; }
  :global(.daa-prose table:nth-of-type(4) td:nth-child(2)) { --cell-label: "Scope and status"; }
  :global(.daa-prose table:nth-of-type(4) td:nth-child(3)) { --cell-label: "Result bound to the tested apparatus"; }
  :global(.daa-prose table:nth-of-type(5) td:nth-child(1)) { --cell-label: "Observable characteristic"; }
  :global(.daa-prose table:nth-of-type(5) td:nth-child(2)) { --cell-label: "Why it may matter"; }
  :global(.daa-prose table:nth-of-type(6) td:nth-child(1)) { --cell-label: "Scenario"; }
  :global(.daa-prose table:nth-of-type(6) td:nth-child(2)) { --cell-label: "Why it matters"; }
  :global(.daa-prose th),
  :global(.daa-prose td) {
    padding: 15px 17px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  :global(.daa-prose th) {
    color: var(--white);
    background: var(--ink-raised);
