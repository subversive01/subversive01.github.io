---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"blog">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const published = entry.data.publishedAt.toLocaleDateString("en-US", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC"
});
---

<BaseLayout
  title={`${entry.data.title} — SBHC Security Blog`}
  description={entry.data.description}
  image={entry.data.shareImage?.src}
  imageAlt={entry.data.shareImage?.alt}
  type="article"
  publishedAt={entry.data.publishedAt}
>
  <div class="research-shell article-shell">
    <SiteHeader active="blog" />
    <main>
      <article class="article">
        <header class="article-header blog-note-header">
          <div class="article-kicker"><a href="/blog/">Blog</a><span>/</span><span>Personal note</span></div>
          <h1>{entry.data.title}</h1>
          <dl class="article-meta blog-note-meta">
            <div><dt>Published</dt><dd><time datetime={entry.data.publishedAt.toISOString()}>{published}</time>{entry.data.author && <span class="blog-byline">Author: <strong>{entry.data.author}</strong></span>}</dd></div>
            <div><dt>Reading time</dt><dd>{entry.data.readingMinutes} minutes</dd></div>
            <div><dt>Tags</dt><dd>{entry.data.tags.length ? entry.data.tags.join(" / ") : "Unfiled"}</dd></div>
          </dl>
        </header>
        <div class="blog-note-body"><div class="prose"><Content /></div></div>
        <footer class="article-end"><p>End of note</p><a href="/blog/">Return to blog <span aria-hidden="true">↗</span></a></footer>
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .blog-note-meta { grid-template-columns: repeat(3, 1fr); }
  .blog-note-body { border-bottom: 1px solid var(--line); }
  .article-shell { --blog-gutter: clamp(16px, 4vw, 64px); }
  .article-header, .article-end { padding-inline: var(--blog-gutter); }
  .blog-byline { display: block; margin-top: .55rem; }
  .blog-byline strong { color: var(--signal); font-weight: inherit; }
  .blog-note-body :global(.prose) {
    box-sizing: border-box;
    max-width: 1440px;
    margin-inline: auto;
    overflow-wrap: anywhere;
    padding-inline: var(--blog-gutter);
    border-left: 0;
  }
  .blog-note-body :global(.prose > *) { max-width: none; }
  .blog-note-body :global(.prose pre) { overflow-x: auto; }
  .blog-note-body :global(.prose table) {
    margin-inline: auto;
    margin-block-end: 1.25rem;
    border-collapse: collapse;
    outline: 1px solid var(--signal-deep);
    outline-offset: -1px;
  }
  .blog-note-body :global(.prose table :is(th, td)) { padding: .45rem .65rem; }
  .blog-note-body :global(.prose table :is(th, td) + :is(th, td)) { border-left: 1px solid var(--line-soft); }
  .blog-note-body :global(.prose table tbody :is(th, td)) { border-top: 1px solid var(--line-soft); }
  @media (max-width: 760px) {
    .blog-note-header h1 { font-size: clamp(2rem, 8vw, 3.5rem); line-height: 1.05; overflow-wrap: anywhere; }
    .blog-note-meta { grid-template-columns: minmax(0, 1fr); }
    .blog-note-meta div,
    .blog-note-meta div + div { padding: 12px 0; border-top: 1px solid var(--line); border-left: 0; }
    .blog-note-meta div:first-child { border-top: 0; }
    .blog-note-meta div:last-child { padding-bottom: 0; }

    .blog-note-body :global(.prose) { padding-block: 28px 48px; }
    .blog-note-body :global(.prose h2) { font-size: clamp(1.7rem, 6vw, 2.5rem); line-height: 1.08; }
    .blog-note-body :global(.prose table) {
      width: 100%;
      table-layout: fixed;
      font-size: .875rem;
      line-height: 1.4;
    }
    .blog-note-body :global(.prose table :is(th, td)) { padding: .4rem; }
  }
</style>
